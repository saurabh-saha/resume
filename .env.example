# Copy to .env and paste your own connection string.
# Neon:     postgresql://<user>:<pass>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
# Supabase: postgresql://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Unset entirely to fall back to the local resume.db SQLite file.
DATABASE_URL=

# Contact line for the built-in resume. Substituted into resume.html at request
# time, so the tracked file never carries personal details.
RESUME_LOCATION=City, Country
RESUME_PHONE=+00-0000000000
RESUME_EMAIL=you@example.com
RESUME_LINKEDIN=linkedin.com/in/you
